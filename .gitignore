__pycache__/
*.pyc
*.venv/
*node_modules*
.env
.idea/
graphify-out/cache/

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfvars
terraform/*.tfvars.json
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/crash.*.log

# Terraform plan files (may contain sensitive variable values)
terraform/tfplan
terraform/*.tfplan
terraform/plan.out

# Frontend build output (CI artifact, should not be tracked)
frontend/dist/

# Claude Code per-developer overrides (project .claude/settings.json IS tracked).
.claude/settings.local.json

# code-review-graph index (rebuilt locally by the PreToolUse hook on git push / gh pr create).
.code-review-graph/

# Claude Code worktrees (isolated workspaces; never committed)
.claude/worktrees/
