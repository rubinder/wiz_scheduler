{
  "nodes": [
    {
      "id": "wizscheduler",
      "type": "system",
      "label": "WizScheduler",
      "description": "Multi-tenant AI-powered employee scheduling web application",
      "source_file": "README.md"
    },
    {
      "id": "fastapi_backend",
      "type": "component",
      "label": "FastAPI Backend",
      "description": "Python 3.11+ backend using FastAPI, Pydantic v2, SQLAlchemy 2.x (Async), PostgreSQL, Alembic",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "react_frontend",
      "type": "component",
      "label": "React Frontend",
      "description": "React 18+, TypeScript, Vite, Tailwind CSS frontend application",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "langgraph_pipeline",
      "type": "component",
      "label": "LangGraph Scheduling Pipeline",
      "description": "Agentic pipeline embedded in FastAPI backend that generates optimized weekly shift schedules per location using LangGraph + Anthropic Claude",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "postgresql",
      "type": "technology",
      "label": "PostgreSQL",
      "description": "PostgreSQL 16+ database with async access via asyncpg and SQLAlchemy 2.x",
      "source_file": "README.md"
    },
    {
      "id": "anthropic_claude",
      "type": "technology",
      "label": "Anthropic Claude",
      "description": "LLM used by the scheduling pipeline via the Anthropic Python SDK (async)",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "jwt_auth",
      "type": "component",
      "label": "JWT Authentication",
      "description": "JWT-based auth using python-jose + passlib[bcrypt], token payload includes sub, company_id, user_role, exp",
      "source_file": "Tasks.md"
    },
    {
      "id": "multi_tenancy",
      "type": "concept",
      "label": "Multi-Tenancy",
      "description": "Every query filters by company_id extracted from the authenticated user's JWT at the application layer",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "availability_draft",
      "type": "concept",
      "label": "Availability Draft",
      "description": "Deep copy of employee availability in SchedulingState, mutated after each location to prevent cross-location double-booking",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "ndjson_streaming",
      "type": "concept",
      "label": "NDJSON Streaming",
      "description": "POST /schedules/generate returns StreamingResponse(media_type='application/x-ndjson'), one JSON line per completed location",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "node_load_location_context",
      "type": "component",
      "label": "load_location_context",
      "description": "Graph node: fetches shift template + eligible employees for current location, filters availability against availability_draft",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "node_build_prompt",
      "type": "component",
      "label": "build_prompt",
      "description": "Graph node: calls prompts.build_schedule_prompt() with parameterized role names from shift template",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "node_call_llm",
      "type": "component",
      "label": "call_llm",
      "description": "Graph node: invokes Claude via Anthropic Python SDK (async), stores raw response text",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "node_parse_schedule",
      "type": "component",
      "label": "parse_schedule",
      "description": "Graph node: extracts JSON array from LLM response, sets status=PARSE_ERROR on failure, never raises",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "node_validate_and_update",
      "type": "component",
      "label": "validate_and_update_availability",
      "description": "Graph node: checks availability_draft for overlaps, retries once on conflict, marks CONFLICT on second failure",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "node_emit_result",
      "type": "component",
      "label": "emit_result",
      "description": "Graph node: yields one NDJSON line with location_id, shifts, errors, status",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "scheduling_state",
      "type": "data_structure",
      "label": "SchedulingState",
      "description": "TypedDict holding company_id, week_start_date, locations, shift_templates, employees, availability_draft, progress, and draft_schedules",
      "source_file": "Tasks.md"
    },
    {
      "id": "shift_assignment",
      "type": "data_structure",
      "label": "ShiftAssignment",
      "description": "TypedDict with employee_id, role_id, role_name, location_id, date, start_time, end_time, status",
      "source_file": "Tasks.md"
    },
    {
      "id": "location_result",
      "type": "data_structure",
      "label": "LocationResult",
      "description": "TypedDict with location_id, location_name, shifts (list of ShiftAssignment), errors, status",
      "source_file": "Tasks.md"
    },
    {
      "id": "use_schedule_stream",
      "type": "component",
      "label": "useScheduleStream Hook",
      "description": "React hook consuming NDJSON stream from /schedules/generate using Fetch Streams API (response.body.getReader())",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "data_table",
      "type": "component",
      "label": "DataTable Component",
      "description": "Reusable inline-editable table supporting column definitions, cell editing, row save/discard, optional bulk-action toolbar",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "use_auth",
      "type": "component",
      "label": "useAuth Hook",
      "description": "React hook managing JWT in localStorage, login/logout state, attaches Bearer token to all requests",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "api_fetch",
      "type": "component",
      "label": "apiFetch",
      "description": "Shared typed fetch wrapper in src/api/ with Bearer token attachment",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "schedule_page",
      "type": "component",
      "label": "Schedule Page",
      "description": "Manager page for AI schedule generation with WeekPicker, progress bar, per-location review with approve/reject/edit",
      "source_file": "Tasks.md"
    },
    {
      "id": "bulk_csv_upload",
      "type": "feature",
      "label": "Bulk CSV Upload",
      "description": "POST /employees/bulk-upload accepts multipart CSV, matches role names case-insensitively against roles table",
      "source_file": "Tasks.md"
    },
    {
      "id": "roles_never_hardcoded",
      "type": "rationale",
      "label": "Roles Never Hardcoded Convention",
      "description": "Design decision: no role name string literal may appear outside seed.py. Every role reference must come from the roles table. This ensures the system is fully dynamic for any tenant's role definitions.",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "defensive_llm_parsing",
      "type": "rationale",
      "label": "Defensive LLM Parsing",
      "description": "Design decision: parse LLM output defensively, never raise unhandled exceptions inside the graph. On parse failure set status=PARSE_ERROR, store raw_llm_output, emit result, continue.",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "serial_location_processing",
      "type": "rationale",
      "label": "Serial Location Processing",
      "description": "Design decision: locations are processed serially in a single graph run so that availability_draft can be mutated after each location to prevent cross-location double-booking.",
      "source_file": "CLAUDE.md"
    },
    {
      "id": "single_retry_strategy",
      "type": "rationale",
      "label": "Single Retry on Conflict",
      "description": "Design decision: on scheduling conflict, retry once with conflict notes added to prompt. On second conflict, mark shift as CONFLICT and continue. Balances quality with latency.",
      "source_file": "Tasks.md"
    },
    {
      "id": "jwt_localstorage",
      "type": "rationale",
      "label": "JWT in localStorage",
      "description": "Design decision: store JWT in localStorage, acceptable for MVP. Simpler than httpOnly cookies for the initial version.",
      "source_file": "Tasks.md"
    },
    {
      "id": "terraform_infra",
      "type": "component",
      "label": "Terraform Infrastructure",
      "description": "Terraform IaC for deploying WizScheduler to AWS with ECS Fargate, RDS, ALB, Secrets Manager",
      "source_file": "terraform/README.md"
    },
