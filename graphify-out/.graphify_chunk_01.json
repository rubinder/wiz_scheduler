      "source_file": "terraform/README.md"
    },
    {
      "id": "aws_ecr",
      "type": "technology",
      "label": "AWS ECR",
      "description": "Container registry for WizScheduler Docker images",
      "source_file": "terraform/README.md"
    },
    {
      "id": "aws_vpc",
      "type": "technology",
      "label": "AWS VPC",
      "description": "VPC with public subnets (ALB, NAT), private subnets (ECS, RDS), single NAT gateway for cost optimization",
      "source_file": "terraform/README.md"
    },
    {
      "id": "single_nat_gateway",
      "type": "rationale",
      "label": "Single NAT Gateway",
      "description": "Design decision: single NAT Gateway keeps costs low. For production HA, add a NAT per AZ.",
      "source_file": "terraform/README.md"
    },
    {
      "id": "security_groups",
      "type": "concept",
      "label": "Security Groups",
      "description": "ALB accepts TCP 80/443 from internet, ECS accepts 8000 from ALB SG only, RDS accepts 5432 from ECS SG only. No direct internet to ECS or DB.",
      "source_file": "terraform/README.md"
    },
