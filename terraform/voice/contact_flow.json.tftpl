${jsonencode({
  Version     = "2019-10-30"
  StartAction = "no-flow-logs"
  Metadata = {
    entryPointPosition = { x = 40, y = 40 }
    ActionMetadata = {
      "no-flow-logs"   = { position = { x = 40, y = 240 } }
      "screen"         = { position = { x = 200, y = 240 } }
      "check-screen"   = { position = { x = 440, y = 240 } }
      "greet"          = { position = { x = 700, y = 240 } }
      "greet-fallback" = { position = { x = 440, y = 440 } }
      "set-voice"      = { position = { x = 200, y = 40 } }
      "host-bot"       = { position = { x = 440, y = 40 } }
      "check-transfer" = { position = { x = 700, y = 40 } }
      "transfer"       = { position = { x = 960, y = 40 } }
      "disconnect"     = { position = { x = 1220, y = 200 } }
    }
  }
  Actions = [
    {
      # Phone numbers are never logged: flow logging is off from here on,
      # before the screen Lambda (caller and dialed numbers) and the bot
      # (the `caller` session attribute) run (voice.tf, voice_connect_flows).
      Identifier = "no-flow-logs"
      Type       = "UpdateFlowLoggingBehavior"
      Parameters = { FlowLoggingBehavior = "Disabled" }
      # The flow language documents no error branches for this action.
      Transitions = { NextAction = "screen" }
    },
    {
      # Call screening (#259 step 7): the screen Lambda answers a flat map,
      # {"action": "answer"|"block", "greeting": ...}, and fails open itself.
      # An error or a timeout here also answers, with the disclosing fallback
      # greeting: only an explicit block disconnects.
      Identifier = "screen"
      Type       = "InvokeLambdaFunction"
      Parameters = {
        LambdaFunctionARN          = screen_lambda_arn
        InvocationTimeLimitSeconds = "3"
        ResponseValidation         = { ResponseType = "STRING_MAP" }
      }
      Transitions = {
        NextAction = "check-screen"
        Errors = [
          { NextAction = "greet-fallback", ErrorType = "NoMatchingError" },
        ]
      }
    },
    {
      Identifier = "check-screen"
      Type       = "Compare"
      Parameters = { ComparisonValue = "$.External.action" }
      Transitions = {
        NextAction = "greet"
        Conditions = [
          { NextAction = "disconnect", Condition = { Operator = "Equals", Operands = ["block"] } },
        ]
        Errors = [{ NextAction = "greet", ErrorType = "NoMatchingCondition" }]
      }
    },
    {
      # The greeting the caller hears first: the screen Lambda's, which
      # follows the location's automated-assistant disclosure setting (it
      # always sets one, disclosing when the backend gave none).
      Identifier = "greet"
      Type       = "UpdateContactAttributes"
      Parameters = {
        TargetContact = "Current"
        Attributes    = { greeting = "$.External.greeting" }
      }
      Transitions = {
        NextAction = "set-voice"
        Errors     = [{ NextAction = "greet-fallback", ErrorType = "NoMatchingError" }]
      }
    },
    {
      # The Lambda failed, so the location's setting is unknown: disclose.
      Identifier = "greet-fallback"
      Type       = "UpdateContactAttributes"
      Parameters = {
        TargetContact = "Current"
        Attributes    = { greeting = "Thanks for calling. You have reached an automated reservations assistant. How can I help you?" }
      }
      Transitions = {
        NextAction = "set-voice"
        Errors     = [{ NextAction = "set-voice", ErrorType = "NoMatchingError" }]
      }
    },
    {
      Identifier = "set-voice"
      Type       = "UpdateContactTextToSpeechVoice"
      Parameters = {
        TextToSpeechVoice  = polly_voice
        TextToSpeechEngine = "Neural"
      }
      # The flow language documents no error branches for this action.
      Transitions = { NextAction = "host-bot" }
    },
    {
      # Every turn goes to the bridge Lambda through the bot's code hook.
      # fallback_transfer_to is deliberately not set: the flow cannot look up
      # the location's staff number, so on a bridge failure the Lambda tells
      # the caller to call back. A backend handoff still transfers (transfer_to).
      Identifier = "host-bot"
      Type       = "ConnectParticipantWithLexBot"
      Parameters = {
        Text     = "$.Attributes.greeting"
        LexV2Bot = { AliasArn = lex_bot_alias_arn }
        LexSessionAttributes = {
          contact_id = "$.ContactId"
          dialed     = "$.SystemEndpoint.Address"
          caller     = "$.CustomerEndpoint.Address"
        }
      }
      Transitions = {
        NextAction = "check-transfer"
        Errors = [
          { NextAction = "check-transfer", ErrorType = "NoMatchingCondition" },
          { NextAction = "check-transfer", ErrorType = "NoMatchingError" },
          { NextAction = "check-transfer", ErrorType = "InputTimeLimitExceeded" },
        ]
      }
    },
    {
      # Both the success and error branches land here: transfer only when
      # the bridge's Close set transfer_to.
      Identifier = "check-transfer"
      Type       = "Compare"
      Parameters = { ComparisonValue = "$.Lex.SessionAttributes.transfer_to" }
      Transitions = {
        NextAction = "transfer"
        Conditions = [
          { NextAction = "disconnect", Condition = { Operator = "Equals", Operands = [""] } },
        ]
        Errors = [{ NextAction = "transfer", ErrorType = "NoMatchingCondition" }]
      }
    },
    {
      Identifier = "transfer"
      Type       = "TransferParticipantToThirdParty"
      Parameters = {
        ThirdPartyPhoneNumber              = "$.Lex.SessionAttributes.transfer_to"
        ThirdPartyConnectionTimeLimitSeconds = "30"
        ContinueFlowExecution              = "False"
      }
      Transitions = {
        NextAction = "disconnect"
        Errors = [
          { NextAction = "disconnect", ErrorType = "CallFailed" },
          { NextAction = "disconnect", ErrorType = "ConnectionTimeLimitExceeded" },
          { NextAction = "disconnect", ErrorType = "NoMatchingError" },
        ]
      }
    },
    {
      Identifier  = "disconnect"
      Type        = "DisconnectParticipant"
      Parameters  = {}
      Transitions = {}
    },
  ]
})}
